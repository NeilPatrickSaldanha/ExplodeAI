# ExplodeAI backend configuration.
# Copy to backend/.env and fill in locally. Never commit backend/.env.

# --- AI provider keys (optional; the app works fully without them) ---
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Paid AI feature guard ---
# Master switch. Paid provider calls are impossible unless this is "true".
AI_FEATURES_ENABLED=false
# Emergency kill switch. "true" blocks every paid call even if enabled above.
AI_EMERGENCY_DISABLE=false
# Hard cap on estimated spend per UTC day, in USD (estimate, not a bill).
AI_DAILY_BUDGET_USD=1.00
# Max paid requests per learner per hour.
AI_MAX_REQUESTS_PER_HOUR=10
# Per-request provider timeout in seconds.
AI_REQUEST_TIMEOUT_SECONDS=20
# Max output tokens a paid request may ask for.
AI_MAX_OUTPUT_TOKENS=300

# --- App ---
DATABASE_URL=sqlite:///./data/explodeai.sqlite3
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Show lessons that have not passed all three verification passes (dev only).
SHOW_DRAFT_LESSONS=false
